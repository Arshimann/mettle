# Optional cloud sync (Phase 5). Leave BOTH blank to run fully local-first —
# the app then hides sign-in and stores everything on-device only.
# Fill these in (and set the same vars in Netlify) to enable account backup +
# cross-device sync. The anon key is public and safe to ship in a client app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Canonical public URL. Only needed if the app moves off mettlegym.netlify.app.
# Links inside password-reset and confirmation emails use this whenever the app
# is running on localhost, so a reset requested in dev still opens the real site.
VITE_SITE_URL=
